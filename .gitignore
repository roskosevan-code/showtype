# Claude Code local settings (per-user, not shared)
.claude/settings.local.json

# Environment / secrets
.env
.env.*
*.local

# Batch-ID records from submit_batches.py --out. Account-scoped identifiers, and
# anything under docs/ is published to showtype.tv — keep them out of the repo.
batches*.json

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
npm-debug.log*
yarn-error.log*

# Local SQLite databases (regenerated via `init-db`)
*.db
*.sqlite
*.sqlite3

# Logs / temp
*.log
tmp/
.claude/worktrees/
